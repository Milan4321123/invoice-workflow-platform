# =====================================================================
# OCR INVOICE PROCESSOR - DOCKER DEPLOYMENT CONFIGURATION
# =====================================================================
# Copy this file to .env and update with your actual company values

# =====================================================================
# DATABASE (Supabase) - REQUIRED
# =====================================================================
SUPA_URL=https://your-project.supabase.co
SUPA_KEY=your-service-role-key-here
SUPA_SERVICE_ROLE_KEY=your-service-role-key-here
SUPA_ANON_KEY=your-anon-key-here

# Frontend database access (same values as above)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =====================================================================
# DOCKER NETWORKING - REQUIRED
# =====================================================================
# Frontend talks to backend through Docker network (local) or Render URLs (production)
# For local Docker: http://localhost:8000
# For Render: https://your-backend-service-name.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# =====================================================================
# EMAIL SERVICE (SendGrid) - REQUIRED
# =====================================================================
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
# Must be a verified sender (or domain) in your SendGrid account
FROM_EMAIL=noreply@yourcompany.com
FROM_NAME=Invoice System
# true = don't send, save each mail as HTML in backend/outbox/ instead
EMAIL_DEMO_MODE=false
# Public URL of the backend, used for the approval links in emails
BASE_URL=http://localhost:8000
# Accounting decides on early payment, so Skonto reminders go here
# (approval requests still go to the Bauleiter entered per invoice)
ACCOUNTING_EMAIL=buchhaltung@yourcompany.com

# =====================================================================
# FOLDER WATCHER - OPTIONAL
# =====================================================================
# New PDFs dropped into this folder are imported automatically
FOLDER_WATCHER_PATH=

# =====================================================================
# SECURITY - REQUIRED
# =====================================================================
# Generate with: openssl rand -base64 64
JWT_SECRET=your-secure-jwt-secret-key-here

# =====================================================================
# ADMIN ACCOUNT - REQUIRED
# =====================================================================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=your-secure-admin-password-here
ADMIN_FULL_NAME=System Administrator

# =====================================================================
# COMPANY INFORMATION - REQUIRED
# =====================================================================
COMPANY_NAME=Your Company Name
COMPANY_EMAIL=info@yourcompany.com

# =====================================================================
# FEATURE SETTINGS - DOCKER DEFAULTS
# =====================================================================
# Using mock services (no additional setup needed)
USE_MOCK_STORAGE=true
USE_MOCK_OCR=true
ENABLE_EMAIL_NOTIFICATIONS=true
NODE_ENV=development

# =====================================================================
# SETUP INSTRUCTIONS
# =====================================================================
# 1. Copy this file: cp environment.template .env
# 2. Get Supabase project details from: https://supabase.com
# 3. Get SendGrid API key from: https://sendgrid.com
# 4. Generate JWT_SECRET: openssl rand -base64 64
# 5. Set strong ADMIN_PASSWORD (12+ characters)
# 6. Update company information
# 7. Start with: ./start-company.sh or start-company.bat

# THAT'S IT! Docker handles everything else automatically.